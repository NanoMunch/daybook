{
  "name": "Daybook",
  "short_name": "Daybook",
  "description": "A private, day-by-day notebook that keeps every note on your phone.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FBF9F4",
